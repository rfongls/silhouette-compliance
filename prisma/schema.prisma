generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BoardStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessStatus {
  PENDING
  RUNNING
  DELIVERED
  FAILED
  REFUNDED
}

enum EntKind {
  ASSESSMENT_CREDIT
  SRA_CREDIT
  PROPOSAL_CREDIT
}

enum EntStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum SraStage {
  SCOPE
  INVENTORY
  EVIDENCE
  FINDINGS
  ROADMAP
  REPORT
}

enum SraStatus {
  ACTIVE
  DELIVERED
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("customer")
  accountId     String    @default(cuid())
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EarlyAccessInterest {
  id                  String    @id @default(cuid())
  email               String
  name                String?
  provider            String
  providerAccountId   String
  providerUsername    String?
  status              String    @default("seen")
  notifyRequested     Boolean   @default(false)
  notifyRequestedAt   DateTime?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @updatedAt

  @@unique([provider, providerAccountId])
  @@index([email])
  @@index([status, lastSeenAt])
  @@map("early_access_interests")
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ControlBoard {
  id            String      @id @default(cuid())
  industry      String
  standardKey   String
  version       Int
  status        BoardStatus
  controls      Json
  controlCount  Int
  sourceTitle   String?
  sourceVersion String?
  sourceUrls    Json?
  sourceHash    String?
  retrievedAt   DateTime?
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNotes   String?
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@index([industry, standardKey, status])
}

model ControlExtractionCheckpoint {
  id           String   @id @default(cuid())
  runId        String
  industry     String
  standardKey  String
  sourceHash   String
  batchKey     String
  controls     Json
  controlCount Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([runId, standardKey, batchKey])
  @@index([industry, standardKey, sourceHash])
}

model Assessment {
  id                String       @id @default(cuid())
  orgId             String
  orgName           String?
  accountId         String
  industry          String
  status            AssessStatus
  score             Int?
  posture           String?
  result            Json?
  boardCite         String?
  boardSnapshot     Json?
  modelProvider     String?
  modelName         String?
  promptVersion     String?
  documentCount     Int?
  sourceCharCount   Int?
  documentHashes    Json?
  sourceSetHash     String?
  phiAttested       Boolean      @default(false)
  phiAttestedAt     DateTime?
  dataHandlingFlags Json?
  progressStage     String?
  progressMessage   String?
  progressCurrent   Int          @default(0)
  progressTotal     Int          @default(0)
  progressUpdatedAt DateTime?
  failureProvider   String?
  failureModel      String?
  failureHttpStatus Int?
  failureCode       String?
  failureRequestId  String?
  failureRetriable  Boolean?
  failureAttempts   Int          @default(0)
  failureStage      String?
  failedAt          DateTime?
  reviewStatus      String       @default("AI_DRAFT")
  reviewedBy        String?
  reviewedAt        DateTime?
  refineUsed        Boolean      @default(false)
  ledgerId          String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  ledger            UsageLedger? @relation(fields: [ledgerId], references: [id])
  checkpoints       AssessmentPassCheckpoint[]

  @@index([accountId, createdAt])
  @@index([accountId, status])
  @@index([accountId, orgId, sourceSetHash, status])
}

model AssessmentPassCheckpoint {
  id                 String     @id @default(cuid())
  assessmentId       String
  passKey            String
  controlBatch       Int
  evidenceChunk      Int
  evaluations        Json
  inputTokens        Int        @default(0)
  outputTokens       Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  assessment         Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, passKey])
  @@index([assessmentId, createdAt])
}

model UsageLedger {
  id           String      @id @default(cuid())
  accountId    String
  kind         String
  status       String
  assessmentId String?     @unique
  orgsBilled   Int?
  amountCents  Int?
  inputTokens  Int?
  outputTokens Int?
  stripeRef    String?
  quoteId      String?
  createdAt    DateTime    @default(now())
  assessment   Assessment?

  @@index([accountId, kind, status])
  @@index([stripeRef])
  @@index([quoteId])
}

model RunQuote {
  id                      String    @id @default(cuid())
  accountId               String
  module                  String
  kind                    EntKind
  orgNames                Json?
  assessmentScope         String    @default("self")
  parentOrgName           String?
  orgCount                Int       @default(1)
  creditsApplied          Int       @default(0)
  creditsToPurchase       Int       @default(0)
  documentCount           Int       @default(0)
  charCount               Int       @default(0)
  sourceDigest            String?
  estimatedInputTokens    Int       @default(0)
  estimatedOutputTokens   Int       @default(0)
  estimatedModelCostCents Int       @default(0)
  customerAmountCents     Int       @default(0)
  marginCents             Int       @default(0)
  withinGuard             Boolean   @default(true)
  preflight               Json?
  preflightAt             DateTime?
  status                  String    @default("QUOTED")
  stripeRef               String?
  acceptedAt              DateTime?
  networkResult           Json?
  networkGeneratedAt      DateTime?
  reportRecipient         String?
  reportAssessmentIds     Json?
  reportEmailStatus       String    @default("PENDING")
  reportEmailId           String?
  reportEmailSentAt       DateTime?
  reportEmailError        String?
  reportDeletedAt         DateTime?
  expiresAt               DateTime
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([accountId, module, status])
  @@index([stripeRef])
}

model Entitlement {
  id        String    @id @default(cuid())
  accountId String
  kind      EntKind
  status    EntStatus @default(ACTIVE)
  balance   Int?
  renewsAt  DateTime?
  stripeRef String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([accountId, kind])
}

model SraEngagement {
  id        String        @id @default(cuid())
  accountId String
  orgName   String
  industry  String
  stage     SraStage      @default(SCOPE)
  status    SraStatus     @default(ACTIVE)
  scope     Json?
  inventory Json?
  findings  Json?
  roadmap   Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  evidence  SraEvidence[]

  @@index([accountId, status])
}

model SraEvidence {
  id           String        @id @default(cuid())
  engagementId String
  kind         String
  filename     String?
  parsed       Json?
  storageKey   String?
  createdAt    DateTime      @default(now())
  engagement   SraEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId])
}
